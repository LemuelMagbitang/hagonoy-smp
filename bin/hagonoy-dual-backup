#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT/config/dual-host.conf"

log()  { printf '[hagonoy] %s\n' "$*"; }
die()  { printf '[hagonoy] ERROR: %s\n' "$*" >&2; exit 1; }
warn() { printf '[hagonoy] WARNING: %s\n' "$*" >&2; }

PLAN_ONLY=false
KEEP_SOURCE_STOPPED=false
if (( $# != 1 )); then
    die "Usage: ./bin/hagonoy-dual-backup --plan|--execute|--execute-keep-stopped"
fi
case "$1" in
    --plan) PLAN_ONLY=true ;;
    --execute) PLAN_ONLY=false ;;
    --execute-keep-stopped)
        PLAN_ONLY=false
        KEEP_SOURCE_STOPPED=true
        ;;
    *) die "Unknown argument: $1. Use --plan, --execute, or --execute-keep-stopped." ;;
esac

: "${WINDOWS_SERVER_DIR:?}"
: "${WINDOWS_BACKUP_DIR:?}"
: "${WINDOWS_TMUX_SESSION:?}"
: "${WINDOWS_JAVA:?}"
: "${UBUNTU_SSH_TARGET:?}"
: "${UBUNTU_SERVER_DIR:?}"
: "${UBUNTU_BACKUP_DIR:?}"
: "${UBUNTU_TMUX_SESSION:?}"
: "${MINECRAFT_PORT:?}"

EXPECTED_WINDOWS_BACKUP_DIR="/mnt/d/Hagonoy-SMP/server-backup"
[[ "$WINDOWS_BACKUP_DIR" == "$EXPECTED_WINDOWS_BACKUP_DIR" ]] ||
    die "Windows backup path still points to a legacy location. Set WINDOWS_BACKUP_DIR to $EXPECTED_WINDOWS_BACKUP_DIR before backing up."

UBUNTU_MANAGER_DIR="${UBUNTU_MANAGER_DIR:-/home/leonardodavinci/hagonoy-smp}"
WINDOWS_START_SCRIPT="${WINDOWS_START_SCRIPT:-start-windows.sh}"
STOP_TIMEOUT_SECONDS="${STOP_TIMEOUT_SECONDS:-180}"
START_TIMEOUT_SECONDS="${START_TIMEOUT_SECONDS:-900}"

for cmd in ssh rsync tar sha256sum tmux flock df du awk timeout python3; do
    command -v "$cmd" >/dev/null 2>&1 || die "Missing command: $cmd"
done

[[ -d "$WINDOWS_BACKUP_DIR" ]] || die "Windows backup vault is missing."
[[ -x "$WINDOWS_JAVA" ]] || die "Windows Java is unavailable."

SSH=(ssh -o BatchMode=yes -o ConnectTimeout=8)

remote() {
    "${SSH[@]}" "$UBUNTU_SSH_TARGET" "$1"
}

windows_port_state() {
    local result
    result="$(timeout 10s powershell.exe -NoProfile -NonInteractive \
        -Command "\$c=Get-NetTCPConnection -State Listen -LocalPort $MINECRAFT_PORT -ErrorAction SilentlyContinue; if (\$c) {'LISTENING'} else {'STOPPED'}" \
        2>/dev/null | tr -d '\r')" || {
        echo UNKNOWN
        return
    }

    case "$result" in
        LISTENING) echo LISTENING ;;
        STOPPED) echo STOPPED ;;
        *) echo UNKNOWN ;;
    esac
}

windows_state() {
    local session=0 port
    tmux has-session -t "$WINDOWS_TMUX_SESSION" 2>/dev/null && session=1 || true
    port="$(windows_port_state)"

    if [[ "$session" == 1 && "$port" == LISTENING ]]; then
        echo RUNNING
    elif [[ "$session" == 0 && "$port" == STOPPED ]]; then
        echo STOPPED
    else
        echo UNKNOWN
    fi
}

ubuntu_state() {
    remote "
        if tmux has-session -t '$UBUNTU_TMUX_SESSION' 2>/dev/null; then s=1; else s=0; fi
        if ss -H -ltn 'sport = :$MINECRAFT_PORT' 2>/dev/null | grep -q .; then p=1; else p=0; fi
        if [ \"\$s\" = 1 ] && [ \"\$p\" = 1 ]; then
            echo RUNNING
        elif [ \"\$s\" = 0 ] && [ \"\$p\" = 0 ]; then
            echo STOPPED
        else
            echo UNKNOWN
        fi
    "
}

server_state() {
    if [[ "$SOURCE_HOST" == UBUNTU ]]; then
        ubuntu_state
    else
        windows_state
    fi
}

remote_tools_check() {
    remote "test -d '$UBUNTU_SERVER_DIR' &&
        test -d '$UBUNTU_BACKUP_DIR' &&
        for c in tmux ss tar sha256sum rsync df du python3; do
            command -v \"\$c\" >/dev/null || exit 1
        done" ||
        die "Ubuntu paths or required tools are unavailable."
}

load_source_metadata() {
    local python_code metadata
    python_code='import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8")); g=d.get("generation"); v=(d.get("minecraft_version"), d.get("paper_version"), d.get("generation_id")); valid=d.get("schema_version")==1 and type(g) is int and g>0 and d.get("host")==sys.argv[2] and d.get("state")=="running" and all(isinstance(x,str) and x.strip() for x in v); print(str(g)+"|"+v[0]+"|"+v[1]+"|"+v[2]) if valid else sys.exit("invalid or mismatched generation manifest")'

    if [[ "$SOURCE_HOST" == UBUNTU ]]; then
        metadata="$(remote "python3 -c '$python_code' '$UBUNTU_SERVER_DIR/.hagonoy-generation.json' ubuntu")" ||
            die "Ubuntu generation manifest is missing, invalid, or does not describe the running Ubuntu generation."
    else
        metadata="$(python3 -c "$python_code" "$WINDOWS_SERVER_DIR/.hagonoy-generation.json" windows)" ||
            die "Windows generation manifest is missing, invalid, or does not describe the running Windows generation."
    fi

    IFS='|' read -r SOURCE_GENERATION SOURCE_MINECRAFT_VERSION SOURCE_PAPER_VERSION SOURCE_GENERATION_ID <<< "$metadata"
    [[ "$SOURCE_GENERATION" =~ ^[1-9][0-9]*$ &&
       -n "$SOURCE_MINECRAFT_VERSION" &&
       -n "$SOURCE_PAPER_VERSION" &&
       -n "$SOURCE_GENERATION_ID" ]] ||
        die "Could not parse the source generation metadata."
}

stop_source() {
    if [[ "$SOURCE_HOST" == UBUNTU ]]; then
        log "Gracefully stopping Ubuntu Minecraft..."
        remote "cd '$UBUNTU_MANAGER_DIR' && ./hagonoy stop" ||
            die "Ubuntu manager could not confirm a graceful stop."
    else
        log "Saving Windows world..."
        tmux send-keys -t "$WINDOWS_TMUX_SESSION" "save-all flush" C-m
        sleep 2
        log "Gracefully stopping Windows Minecraft..."
        tmux send-keys -t "$WINDOWS_TMUX_SESSION" "stop" C-m
    fi

    local elapsed=0 state
    while (( elapsed < STOP_TIMEOUT_SECONDS )); do
        state="$(server_state)" || state=UNKNOWN
        if [[ "$state" == STOPPED ]]; then
            log "$SOURCE_HOST server is confirmed stopped."
            return 0
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done

    die "Graceful shutdown could not be confirmed. No archive will be created."
}

start_source() {
    if [[ "$SOURCE_HOST" == UBUNTU ]]; then
        log "Restarting Ubuntu Minecraft..."
        remote "cd '$UBUNTU_MANAGER_DIR' && ./hagonoy start"
        return
    fi

    log "Restarting Windows Minecraft..."
    tmux new-session -d \
        -s "$WINDOWS_TMUX_SESSION" \
        -c "$WINDOWS_SERVER_DIR" \
        "bash -lc './$WINDOWS_START_SCRIPT'"

    local elapsed=0 state
    while (( elapsed < START_TIMEOUT_SECONDS )); do
        state="$(windows_state)"
        [[ "$state" == RUNNING ]] && return 0
        tmux has-session -t "$WINDOWS_TMUX_SESSION" 2>/dev/null ||
            return 1
        sleep 3
        elapsed=$((elapsed + 3))
    done

    return 1
}

WINDOWS_PART=""
UBUNTU_PART=""
SOURCE_HOST=""
RESTART_REQUIRED=false

cleanup() {
    local rc=$?
    trap - EXIT INT TERM

    [[ -z "$WINDOWS_PART" ]] || rm -f -- "$WINDOWS_PART"

    if [[ -n "$UBUNTU_PART" ]]; then
        remote "rm -f -- '$UBUNTU_PART'" >/dev/null 2>&1 || true
    fi

    if [[ "$RESTART_REQUIRED" == true ]]; then
        local state
        state="$(server_state 2>/dev/null || echo UNKNOWN)"

        if [[ "$state" == STOPPED ]]; then
            start_source || {
                warn "Automatic restart failed. Inspect the server before manually starting it."
                rc=1
            }
        elif [[ "$state" == RUNNING ]]; then
            log "Server is already running; no duplicate start attempted."
        else
            warn "Server state is uncertain. No automatic start attempted."
            rc=1
        fi
    fi

    exit "$rc"
}

echo "========== HSMP DUAL BACKUP =========="

remote_tools_check

WINDOWS_STATE="$(windows_state)"
UBUNTU_STATE="$(ubuntu_state)"

printf 'Windows server: %s\n' "$WINDOWS_STATE"
printf 'Ubuntu server:  %s\n' "$UBUNTU_STATE"

[[ "$WINDOWS_STATE" != UNKNOWN && "$UBUNTU_STATE" != UNKNOWN ]] ||
    die "A host is unreachable or its server state is uncertain."

if [[ "$WINDOWS_STATE" == RUNNING && "$UBUNTU_STATE" == RUNNING ]]; then
    die "Both servers are running. Resolve this before backing up."
fi

if [[ "$WINDOWS_STATE" == STOPPED && "$UBUNTU_STATE" == STOPPED ]]; then
    die "Both servers are stopped. Offline source selection requires generation tracking."
fi

if [[ "$UBUNTU_STATE" == RUNNING ]]; then
    SOURCE_HOST=UBUNTU
    SOURCE_DIR="$UBUNTU_SERVER_DIR"
    SOURCE_BYTES="$(remote "du -sb -- '$SOURCE_DIR' | awk '{print \$1}'")"
else
    SOURCE_HOST=WINDOWS
    SOURCE_DIR="$WINDOWS_SERVER_DIR"

    [[ -d "$WINDOWS_SERVER_DIR" ]] || die "Windows server directory is missing."
    [[ -f "$WINDOWS_SERVER_DIR/$WINDOWS_START_SCRIPT" ]] ||
        die "Windows restart script is missing: $WINDOWS_START_SCRIPT."

    SOURCE_BYTES="$(du -sb -- "$SOURCE_DIR" | awk '{print $1}')"
fi

[[ "$SOURCE_BYTES" =~ ^[0-9]+$ ]] || die "Could not measure server directory."

load_source_metadata

WIN_FREE="$(df -Pk "$WINDOWS_BACKUP_DIR" | awk 'NR==2 {print $4}')"
UBU_FREE="$(remote "df -Pk -- '$UBUNTU_BACKUP_DIR' | awk 'NR==2 {print \$4}'")"
NEEDED=$((SOURCE_BYTES + 128 * 1024 * 1024))

[[ "$WIN_FREE" =~ ^[0-9]+$ && "$UBU_FREE" =~ ^[0-9]+$ ]] ||
    die "Could not measure backup storage."

(( WIN_FREE * 1024 >= NEEDED )) || die "Insufficient Windows backup space."
(( UBU_FREE * 1024 >= NEEDED )) || die "Insufficient Ubuntu backup space."

STAMP="$(date +%Y%m%dT%H%M%S%z)"
MC_TAG="$(printf '%s' "$SOURCE_MINECRAFT_VERSION" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-')"
PAPER_TAG="$(printf '%s' "$SOURCE_PAPER_VERSION" | LC_ALL=C tr -c 'A-Za-z0-9._-' '-')"
NAME=""
BASE_NAME="hagonoy-smp-${SOURCE_HOST,,}-mc${MC_TAG}-paper${PAPER_TAG}-gen${SOURCE_GENERATION}-${STAMP}"

for n in $(seq 0 99); do
    if (( n == 0 )); then
        candidate="$BASE_NAME.tar"
    else
        printf -v number '%02d' "$n"
        candidate="$BASE_NAME-$number.tar"
    fi

    if [[ ! -e "$WINDOWS_BACKUP_DIR/$candidate" &&
          ! -e "$WINDOWS_BACKUP_DIR/$candidate.part" ]] &&
       remote "test ! -e '$UBUNTU_BACKUP_DIR/$candidate' &&
               test ! -e '$UBUNTU_BACKUP_DIR/$candidate.part'"; then
        NAME="$candidate"
        break
    fi
done

[[ -n "$NAME" ]] || die "No unused backup filename found."

WINDOWS_ARCHIVE="$WINDOWS_BACKUP_DIR/$NAME"
WINDOWS_PART="$WINDOWS_ARCHIVE.part"
UBUNTU_ARCHIVE="$UBUNTU_BACKUP_DIR/$NAME"
UBUNTU_PART="$UBUNTU_ARCHIVE.part"

echo
echo "========== BACKUP PLAN =========="
printf 'Source host:       %s\n' "$SOURCE_HOST"
printf 'Generation:        %s\n' "$SOURCE_GENERATION"
printf 'Minecraft version: %s\n' "$SOURCE_MINECRAFT_VERSION"
printf 'Paper version:     %s\n' "$SOURCE_PAPER_VERSION"
printf 'Size:              %s bytes\n' "$SOURCE_BYTES"
printf 'Archive:           %s\n' "$NAME"
printf 'Windows free:      %s KiB\n' "$WIN_FREE"
printf 'Ubuntu free:       %s KiB\n' "$UBU_FREE"

if [[ "$PLAN_ONLY" == true ]]; then
    log "PLAN ONLY. No server stopped and no archive created."
    exit 0
fi

LOCK="${XDG_RUNTIME_DIR:-/tmp}/hagonoy-dual-backup.lock"
exec 9>"$LOCK"
flock -n 9 || die "Another backup operation is already running."

# Recheck immediately before stopping.
[[ "$(windows_state)" == "$WINDOWS_STATE" &&
   "$(ubuntu_state)" == "$UBUNTU_STATE" ]] ||
    die "Server states changed during preflight. Retry after inspection."

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

RESTART_REQUIRED=true
stop_source

echo
log "Creating complete HSMP server TAR archive..."

if [[ "$SOURCE_HOST" == UBUNTU ]]; then
    printf -v qsource '%q' "$UBUNTU_SERVER_DIR"
    remote "tar -cf - -C $qsource ." > "$WINDOWS_PART"
else
    tar -cf "$WINDOWS_PART" -C "$WINDOWS_SERVER_DIR" .
fi

[[ -s "$WINDOWS_PART" ]] || die "Archive is empty."
tar -tf "$WINDOWS_PART" >/dev/null ||
    die "Windows archive failed readability verification."

WINDOWS_HASH="$(sha256sum "$WINDOWS_PART" | awk '{print $1}')"
[[ "$WINDOWS_HASH" =~ ^[a-fA-F0-9]{64}$ ]] ||
    die "Windows archive SHA-256 calculation failed."

[[ ! -e "$WINDOWS_ARCHIVE" ]] || die "Final Windows archive already exists."
mv -- "$WINDOWS_PART" "$WINDOWS_ARCHIVE"
WINDOWS_PART=""

log "Windows archive verified."
log "Transferring the same archive to Ubuntu..."

rsync -t --partial \
    -e 'ssh -o BatchMode=yes -o ConnectTimeout=8' \
    "$WINDOWS_ARCHIVE" \
    "$UBUNTU_SSH_TARGET:$UBUNTU_PART" ||
    die "Transfer failed. The verified Windows archive is retained."

remote "tar -tf '$UBUNTU_PART' >/dev/null" ||
    die "Ubuntu TAR readability verification failed."

REMOTE_HASH="$(remote "sha256sum '$UBUNTU_PART' | awk '{print \$1}'")"

[[ "$WINDOWS_HASH" == "$REMOTE_HASH" ]] ||
    die "SHA-256 mismatch. Windows archive retained."

remote "test ! -e '$UBUNTU_ARCHIVE' && mv -- '$UBUNTU_PART' '$UBUNTU_ARCHIVE'" ||
    die "Could not finalize Ubuntu archive."

UBUNTU_PART=""

echo
echo "========== BACKUP VERIFIED =========="
printf 'Source: %s | Minecraft: %s | Paper: %s | Generation: %s\n' \
    "$SOURCE_HOST" "$SOURCE_MINECRAFT_VERSION" "$SOURCE_PAPER_VERSION" "$SOURCE_GENERATION"
printf 'Archive: %s\n' "$NAME"
printf 'SHA-256: %s\n' "$WINDOWS_HASH"
echo "Windows server-backup: VERIFIED"
echo "Ubuntu server-backup:  VERIFIED"
echo "One complete archive; two matching copies."

if [[ "$KEEP_SOURCE_STOPPED" == true ]]; then
    RESTART_REQUIRED=false
    log "Verified backup complete. Source intentionally remains STOPPED for the maintenance transaction."
fi
