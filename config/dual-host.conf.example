# Hagonoy SMP two-host coordinator
# Actual machine-specific configuration: config/dual-host.conf

# Windows server running through WSL2 TMUX with Windows-native Java.
WINDOWS_SERVER_DIR="/mnt/d/Hagonoy-SMP/minecraft-server"
WINDOWS_BACKUP_DIR="/mnt/d/Hagonoy-SMP/server-backup"
WINDOWS_TMUX_SESSION="mcserver"
WINDOWS_JAVA="/mnt/c/Program Files/Eclipse Adoptium/jdk-25.0.5.8-hotspot/bin/java.exe"

# Ubuntu laptop, controlled through SSH.
UBUNTU_SSH_TARGET="leonardodavinci@192.168.100.95"
UBUNTU_SERVER_DIR="/home/leonardodavinci/minecraft-server"
UBUNTU_BACKUP_DIR="/home/leonardodavinci/server-backup"
UBUNTU_TMUX_SESSION="mcserver"

# Shared Minecraft network settings.
MINECRAFT_PORT="25565"
BEDROCK_PORT="19132"

# Startup and shutdown checks.
READY_PATTERN="Done"
START_TIMEOUT_SECONDS="900"
STOP_TIMEOUT_SECONDS="180"

# Chunky border pre-generation (used by ./hagonoy border --apply).
# These must match the Bukkit world names shown by /worlds or Chunky's world list.
CHUNKY_OVERWORLD_WORLD="world"
CHUNKY_NETHER_WORLD="world_nether"
CHUNKY_END_WORLD="world_the_end"
# Maximum Chunky chunks/second PER DIMENSION. 1 is conservative; 0 is unlimited.
CHUNKY_RATE_LIMIT="1"
